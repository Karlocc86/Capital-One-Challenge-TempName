# Copia este archivo a ".env" y pon tu API key real de Nessie
# La consigues en http://api.nessieisreal.com/ (regístrate con GitHub)
NESSIE_API_KEY=tu_api_key_aqui

# Base URL de Nessie. Usar HTTPS: en algunas redes (ej. campus/hackathon)
# el puerto 80 (HTTP) está bloqueado por firewall, pero la API responde
# igual de bien por HTTPS.
NESSIE_BASE_URL=https://api.nessieisreal.com

# Connection string de Postgres (Supabase). Project Settings > Database >
# Connection string, modo "Session pooler".
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_db

# API key gratis de Gemini (sin tarjeta). Sácala en aistudio.google.com/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Account del usuario demo. Lo imprime `python scripts/seed.py` al final.
# Los scripts de prueba (test_forecaster.py, test_agent.py) lo leen de aquí.
DEMO_ACCOUNT_ID=tu_account_id_demo

# Orígenes permitidos por CORS (separados por coma). En local no hace falta;
# en producción pon el dominio del frontend en Vercel.
# FRONTEND_ORIGINS=https://tu-app.vercel.app
